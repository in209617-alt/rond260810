{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && auth.token.email_verified === true && (auth.token.email === 'MY_EMAIL@gmail.com' || auth.token.email === 'FRIEND_EMAIL@gmail.com') && $room.matches(/^[a-z0-9-]{1,24}$/)",
        "players": {
          "$slot": {
            ".write": "auth != null && auth.token.email_verified === true && (auth.token.email === 'MY_EMAIL@gmail.com' || auth.token.email === 'FRIEND_EMAIL@gmail.com') && $room.matches(/^[a-z0-9-]{1,24}$/) && $slot.matches(/^[01]$/) && (!data.exists() || data.child('uid').val() === auth.uid || data.child('t').val() < now - 20000) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'name', 'slot', 'x', 'y', 'dir', 'moving', 'running', 't'])",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
            "slot": { ".validate": "(newData.val() === 0 && $slot === '0') || (newData.val() === 1 && $slot === '1')" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 960" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 720" },
            "dir": { ".validate": "newData.isString() && newData.val().matches(/^(up|down|left|right)$/)" },
            "moving": { ".validate": "newData.isBoolean()" },
            "running": { ".validate": "newData.isBoolean()" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "look": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "$other": { ".validate": false }
          }
        },
        "chat": {
          ".indexOn": ["t"],
          "$id": {
            ".write": "auth != null && !data.exists() && newData.exists() && (root.child('rooms').child($room).child('players').child('0').child('uid').val() === auth.uid || root.child('rooms').child($room).child('players').child('1').child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'name', 'slot', 'text', 't'])",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
            "slot": { ".validate": "newData.val() === 0 || newData.val() === 1" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "events": {
          ".indexOn": ["t"],
          "$id": {
            ".write": "auth != null && (root.child('rooms').child($room).child('players').child('0').child('uid').val() === auth.uid || root.child('rooms').child($room).child('players').child('1').child('uid').val() === auth.uid) && ((!data.exists() && newData.child('uid').val() === auth.uid) || !newData.exists())",
            ".validate": "newData.hasChildren(['uid', 'from', 'to', 'type', 't'])",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "from": { ".validate": "newData.isString() && newData.val().matches(/^[01]$/)" },
            "to": { ".validate": "newData.isString() && newData.val().matches(/^[01]$/)" },
            "type": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "item": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "profiles": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('rooms').child($room).child('players').child('0').child('uid').val() === auth.uid || root.child('rooms').child($room).child('players').child('1').child('uid').val() === auth.uid)",
            ".validate": "newData.isString() && newData.val().length <= 400000 && newData.val().beginsWith('data:image/png')"
          }
        }
      }
    }
  }
}
